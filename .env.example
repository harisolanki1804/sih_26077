# VARUNA Environment Variables

# Database (default: SQLite)
DATABASE_URL=sqlite:///varuna.db

# MOSDAC Satellite Data (username/password only, no API key)
# Register at: https://mosdac.gov.in/
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
